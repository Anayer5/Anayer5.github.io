<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.EventTrackingApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/text_on_primary</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
    </style>

    <style name="Theme.EventTrackingApp" parent="Base.Theme.EventTrackingApp" />
</resources>
