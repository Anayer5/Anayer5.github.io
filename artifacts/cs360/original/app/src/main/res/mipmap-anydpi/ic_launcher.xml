<?xml version="1.0" encoding="utf-8"?>
<!-- The full Event Tracker artwork is used as the background layer so the launcher
     simply masks it to the device's icon shape. The foreground is transparent. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_image" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
